  object Query_jogo: TZQuery
    Connection = Form1.CnnCatalogo
    SQL.Strings = (
      'select g.*, img.image_byte'
      'from games g, images img'
      'where img.game_id = g.id'
      '  and img.is_cover = 1'
      '  and g.deleted = 0'
      '  and g.id = :id'
    )
    Params = <    
      item
        DataType = ftInteger
        Name = 'id'
        ParamType = ptInput
        SQLType = stInteger
      end>
    Left = 49
    Top = 72
    ParamData = <    
      item
        DataType = ftInteger
        Name = 'id'
        ParamType = ptInput
        SQLType = stInteger
      end>
  end
  object Query_genres: TZQuery
    Params = <>
    Left = 48
    Top = 144
  end
  object Query_comentarios: TZQuery
    Connection = Form1.CnnCatalogo
    SQL.Strings = (
      'select u.nickname,gc.user_id,gc.comment_text, gc.created_at'
      'from game_comments gc, users u'
      'where u.id = gc.user_id'
      'and gc.game_id = :game_id'
      'order by gc.created_at desc'
      'limit :limit'
    )
    Params = <    
      item
        DataType = ftInteger
        Name = 'game_id'
        ParamType = ptInput
        SQLType = stInteger
      end    
      item
        Name = 'limit'
      end>
    Left = 48
    Top = 208
    ParamData = <    
      item
        DataType = ftInteger
        Name = 'game_id'
        ParamType = ptInput
        SQLType = stInteger
      end    
      item
        Name = 'limit'
      end>
