  object Query_itens_pagamento: TZQuery
    Connection = Form1.CnnCatalogo
    SQL.Strings = (
      'select g.id as game_id, g.name, g.price, img.image_byte'
      'from games g, images img, cart c'
      'where img.game_id = g.id'
      '  and img.is_cover = 1'
      '  and g.id = c.game_id'
      '  and c.user_id = :user_id;'
    )
    Params = <    
      item
        Name = 'user_id'
      end>
    Left = 80
    Top = 88
    ParamData = <    
      item
        Name = 'user_id'
      end>
  end
  object Query_forma_pagamento: TZQuery
    Connection = Form1.CnnCatalogo
    SQL.Strings = (
      'select id, name from payment_method order by id;'
    )
    Params = <>
    Left = 80
    Top = 152
  end
  object Query_dados_user: TZQuery
    Connection = Form1.CnnCatalogo
    SQL.Strings = (
      'select nickname, amount '
      'from users '
      'where id = :user_id;'
    )
    Params = <    
      item
        Name = 'user_id'
      end>
    Left = 80
    Top = 229
    ParamData = <    
      item
        Name = 'user_id'
      end>
  end
  object Query_transacao: TZQuery
    Connection = Form1.CnnCatalogo
    SQL.Strings = (
      'INSERT INTO transactions (order_id, payment_method_id, status, total_price)'
      'VALUES (:order_id, :payment_method_id, ''approved'', :total_price);'
    )
    Params = <    
      item
        Name = 'order_id'
      end    
      item
        Name = 'payment_method_id'
      end    
      item
        Name = 'total_price'
      end>
    Left = 81
    Top = 297
    ParamData = <    
      item
        Name = 'order_id'
      end    
      item
        Name = 'payment_method_id'
      end    
      item
        Name = 'total_price'
      end>
  end
  object Query_criar_order: TZQuery
    Connection = Form1.CnnCatalogo
    SQL.Strings = (
      'INSERT INTO orders (user_id) VALUES (:user_id);'
    )
    Params = <    
      item
        DataType = ftInteger
        Name = 'user_id'
        ParamType = ptInput
        SQLType = stInteger
      end>
    Left = 81
    Top = 374
    ParamData = <    
      item
        DataType = ftInteger
        Name = 'user_id'
        ParamType = ptInput
        SQLType = stInteger
      end>
  end
  object Query_alocar_chave: TZQuery
    Connection = Form1.CnnCatalogo
    SQL.Strings = (
      'INSERT INTO order_keys (order_id, key_id, unit_price)'
      'SELECT :order_id, k.id, g.price'
      'FROM cart c, keys k, games g'
      'WHERE c.game_id = g.id'
      'AND k.game_id = c.game_id'
      'AND k.key_status_id = 1'
      'AND k.id = (SELECT MIN(id) FROM keys WHERE game_id = c.game_id AND key_status_id = 1)'
      'AND c.user_id = :user_id;'
    )
    Params = <    
      item
        DataType = ftInteger
        Name = 'order_id'
        ParamType = ptInput
        SQLType = stInteger
      end    
      item
        DataType = ftInteger
        Name = 'user_id'
        ParamType = ptInput
        SQLType = stInteger
      end>
    Left = 80
    Top = 440
    ParamData = <    
      item
        DataType = ftInteger
        Name = 'order_id'
        ParamType = ptInput
        SQLType = stInteger
      end    
      item
        DataType = ftInteger
        Name = 'user_id'
        ParamType = ptInput
        SQLType = stInteger
      end>
  end
  object Query_vender_chaves: TZQuery
    Connection = Form1.CnnCatalogo
    SQL.Strings = (
      'UPDATE keys SET key_status_id = 3'
      'WHERE id IN ('
      '  SELECT key_id FROM order_keys WHERE order_id = :order_id'
      ');'
    )
    Params = <    
      item
        DataType = ftInteger
        Name = 'order_id'
        ParamType = ptInput
        SQLType = stInteger
      end>
    Left = 80
    Top = 512
    ParamData = <    
      item
        DataType = ftInteger
        Name = 'order_id'
        ParamType = ptInput
        SQLType = stInteger
      end>
  end
  object Query_limpar_carrinho: TZQuery
    Connection = Form1.CnnCatalogo
    SQL.Strings = (
      'DELETE FROM cart WHERE user_id = :user_id;'
    )
    Params = <    
      item
        DataType = ftInteger
        Name = 'user_id'
        ParamType = ptInput
        SQLType = stInteger
      end>
    Left = 81
    Top = 576
    ParamData = <    
      item
        DataType = ftInteger
        Name = 'user_id'
        ParamType = ptInput
        SQLType = stInteger
      end>
  end
  object Query_buscar_order: TZQuery
    Connection = Form1.CnnCatalogo
    SQL.Strings = (
      'SELECT MAX(id) as id FROM orders WHERE user_id = :user_id;'
    )
    Params = <    
      item
        Name = 'user_id'
      end>
    Left = 80
    Top = 645
    ParamData = <    
      item
        Name = 'user_id'
      end>
  end
