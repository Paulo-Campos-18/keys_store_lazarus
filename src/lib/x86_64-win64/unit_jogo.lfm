  object Query_total_keys: TZQuery
    Connection = Form1.CnnCatalogo
    SQL.Strings = (
      'select g.id, g.name, count(k.id) as Total_disponivel'
      'from games g, keys k'
      'where g.id = k.game_id'
      'and k.key_status_id = 1'
      'and g.id = :game_id'
      'group by g.id, g.name;'
    )
    Params = <    
      item
        DataType = ftInteger
        Name = 'game_id'
        ParamType = ptInput
        SQLType = stInteger
      end>
    Left = 186
    Top = 514
    ParamData = <    
      item
        DataType = ftInteger
        Name = 'game_id'
        ParamType = ptInput
        SQLType = stInteger
      end>
  end
  object Query_generos: TZQuery
    Connection = Form1.CnnCatalogo
    SQL.Strings = (
      'select g.name'
      'from genres g, game_genres gg'
      'where g.id = gg.genre_id'
      'and gg.game_id = :game_id;'
    )
    Params = <    
      item
        DataType = ftInteger
        Name = 'game_id'
