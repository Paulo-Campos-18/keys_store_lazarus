    Top = 194
  end
  object Query_comentarios: TZQuery
    Connection = Form1.CnnCatalogo
    SQL.Strings = (
      'select u.nickname,gc.user_id,gc.comment_text, gc.created_at'
      'from game_comments gc, users u'
      'where u.id = gc.user_id'
      'and gc.game_id = :game_id'
      'order by gc.created_at desc'
      'limit :limit'
    )
    Params = <    
      item
        DataType = ftInteger
        Name = 'game_id'
        ParamType = ptInput
        SQLType = stInteger
      end    
      item
        Name = 'limit'
      end>
    Left = 184
    Top = 277
    ParamData = <    
      item
        DataType = ftInteger
        Name = 'game_id'
        ParamType = ptInput
        SQLType = stInteger
      end    
      item
        Name = 'limit'
      end>
