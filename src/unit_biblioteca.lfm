  object Query_biblioteca: TZQuery
    Connection = Form1.CnnCatalogo
    SQL.Strings = (
      'select distinct g.id as game_id, g.name, img.image_byte'
      'from orders o, order_keys ok, keys k, games g, images img'
      'where o.id = ok.order_id'
      'and ok.key_id = k.id'
      'and k.game_id = g.id'
      'and img.game_id = g.id'
      'and img.is_cover = 1'
      'and o.user_id = :user_id;'
    )
    Params = <    
      item
        Name = 'user_id'
      end>
    Left = 1168
    Top = 920
    ParamData = <    
      item
        Name = 'user_id'
      end>
  end
  object Query_chave: TZQuery
    Connection = Form1.CnnCatalogo
    SQL.Strings = (
      'select k.key_code'
      'from orders o, order_keys ok, keys k'
      'where o.id = ok.order_id'
      'and ok.key_id = k.id'
      'and k.game_id = :game_id'
      'and o.user_id = :user_id'
      'limit 1;'
    )
    Params = <    
      item
        Name = 'game_id'
      end    
      item
        Name = 'user_id'
      end>
    Left = 1064
    Top = 896
    ParamData = <    
      item
        Name = 'game_id'
      end    
      item
        Name = 'user_id'
      end>
  end
